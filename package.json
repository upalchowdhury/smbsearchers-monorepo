{
  "name": "dealflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:full": "concurrently \"next dev --turbopack\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "npx tsx src/jobs/worker-entry.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:gen": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:setup": "npx prisma db push --accept-data-loss && npx tsx src/scripts/seed-sources.ts",
    "db:fts": "npx prisma db execute --schema prisma/schema.prisma --file migrations/add_search_vector.sql",
    "data:import": "npx tsx src/scripts/import-scraped-csv.ts",
    "seed": "npx tsx src/scripts/seed-sources.ts",
    "scrape:test": "npx tsx src/scripts/test-scrape.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.70.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.4",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "nuqs": "^2.8.9",
    "playwright": "^1.58.2",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.35",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
